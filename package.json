{
  "name": "lumora",
  "version": "0.4.2",
  "private": true,
  "author": "HAYASAKA7",
  "description": "Local workspace and terminal manager for native AI-agent CLIs",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run helper:ensure && install-electron --no",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package:dir": "npm run helper:build && npm run build && electron-builder --dir",
    "package": "npm run helper:build && npm run build && electron-builder",
    "verify": "npm test && npm run locales:validate && npm run locales:check-strings && npm run helper:test && npm run build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "benchmark:catalog": "vitest bench src/main/catalog/catalog-service.bench.ts --run --project node",
    "benchmark:startup": "vitest bench src/main/providers/provider-scan-coordinator.bench.ts --run --project node",
    "benchmark:transfer": "vitest bench src/main/transfer/session-transfer-service.bench.ts --run --project node",
    "benchmark:terminal": "vitest bench src/main/terminal/output-buffer.bench.ts --run --project node",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "locales:validate": "node scripts/localization/validate-locales.cjs resources/locales",
    "locales:check-strings": "node scripts/localization/check-renderer-strings.cjs",
    "helper:test": "node scripts/helper/generate-provider-probes.cjs && go -C helper test ./...",
    "helper:ensure": "node scripts/helper/ensure-helper.cjs",
    "helper:build": "node scripts/helper/build-helper.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "intl-messageformat": "11.2.14",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ssh2": "1.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ssh2": "1.15.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
